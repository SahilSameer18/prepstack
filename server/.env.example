# ==============================================================================
# PrepStack Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server Port
PORT=3000

# MongoDB Database Connection URL
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/prepstack?retryWrites=true&w=majority

# JWT Secrets (Generate high-entropy strings using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_SECRET=your_jwt_access_secret_32_bytes_hex
REFRESH_SECRET=your_jwt_refresh_secret_32_bytes_hex

# Google Gemini AI API Key (for AI project idea generation)
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional AI fallbacks. If a provider has no key it is skipped. Model IDs: run `node scripts/list-models.js`.
# Order tried: GEMINI_PRIMARY_MODEL, GEMINI_FALLBACK_MODEL, GEMINI_FALLBACK_2_MODEL, then Groq.
# Groq key (free): https://console.groq.com/keys
GROQ_API_KEY=
GEMINI_PRIMARY_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_FALLBACK_2_MODEL=
GROQ_MODEL=
# Most AI project ideas one user may generate per day (default 15)
AI_DAILY_LIMIT=
# Most Role Analyzer reports one user may save in 24 hours (default 5)
ANALYZER_DAILY_LIMIT=

# Google OAuth Client ID (for Google Sign-In & account linking)
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Runtime mode. Set NODE_ENV=production on your host. (development = full error stack traces in responses)
NODE_ENV=development

# Extra browser origins allowed by CORS, comma separated (exact match, no wildcards).
# Defaults already allowed: http://localhost:5173 and https://prepstack-ss.vercel.app
# Add your deployed front-end URL(s) here if they are different, e.g. a custom domain.
ALLOWED_ORIGINS=
# Single-origin shorthand: CLIENT_URL=https://your-frontend.example.com (only used when ALLOWED_ORIGINS is empty)

# Set to true ONLY on a machine whose ISP cannot resolve mongodb+srv:// (SRV) records.
# Forces public DNS (1.1.1.1 / 8.8.8.8) for the whole process. Leave unset in production.
ENABLE_CUSTOM_DNS=

# Password reset email, sent through Brevo SMTP (https://app.brevo.com). Without these, "Forgot password?" answers 503.
# EMAIL_FROM must be a sender you verified in Brevo. BREVO_SMTP_LOGIN and BREVO_SMTP_KEY are on Brevo: SMTP & API.
# CLIENT_URL is where the emailed link points (http://localhost:5173 locally, your site address in production).
EMAIL_PROVIDER=brevo
EMAIL_FROM="PrepStack <your-verified-sender@example.com>"
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
CLIENT_URL=http://localhost:5173
