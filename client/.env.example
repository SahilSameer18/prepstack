# ==============================================================================
# PrepStack Frontend Environment Configuration Template
# Copy this file to .env and fill in your actual configurations.
# ==============================================================================

# Backend API URL (Base URL for backend requests)
# Development: http://localhost:3000
# Production: https://your-backend-domain.vercel.app or https://your-backend.onrender.com
VITE_API_URL=http://localhost:3000

# Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com